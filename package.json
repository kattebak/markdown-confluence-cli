{
	"name": "@kattebak/markdown-confluence-cli",
	"version": "0.0.1",
	"description": "Synchronize markdown files to a confluence page",
	"type": "module",
	"main": "dist/cli.js",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"bin": {
		"markdown-confluence-sync": "dist/cli.js"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"build": "tsc",
		"test": "tsc --noEmit && biome check src && node --import tsx --test \"src/**/*.test.ts\"",
		"watch:test": "node --watch --import tsx --test \"src/**/*.test.ts\"",
		"fix": "biome check src --fix",
		"start": "source .envrc && npx tsx src/cli.ts -f README.md -u $CONFLUENCE_USER -t $CONFLUENCE_TOKEN -d $CONFLUENCE_DOMAIN -i $CONFLUENCE_SPACE_ID list",
		"dev": "tsx src/cli.ts"
	},
	"author": "Matthijs van Henten",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/node": "^26.2.0",
		"semantic-release": "^25.0.9",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@kattebak/confluence-axios-client-v1": "^1.0.1",
		"@kattebak/confluence-axios-client-v2": "^1.0.1",
		"marklassian": "1.2.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kattebak/markdown-confluence-cli.git"
	}
}
